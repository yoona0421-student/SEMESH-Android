<?xml version="1.0" encoding="utf-8"?>
<!-- 메인 화면: [내 위치] → [우리 동네 위험도 카드] → [메뉴 버튼 3개]
     디자인은 나중에 바꾸고, 지금은 어떤 정보가 어디에 들어갈지만 배치한다. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ① 내 위치 영역 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_location_label"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_location_none"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/main_btn_location" />

        <!-- ② 위험도 카드: 지금은 회색 테두리 상자. 등급(고위험/주의/안전)에 따라 색을 바꿀 예정 -->
        <LinearLayout
            android:id="@+id/cardRisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#EEEEEE"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_card_title"
                android:textSize="14sp" />

            <!-- 예: "서울 강서구" -->
            <TextView
                android:id="@+id/tvRegion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="-"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 예: "고위험" / "주의" / "안전" -->
            <TextView
                android:id="@+id/tvGrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="등급: -"
                android:textSize="18sp" />

            <!-- 예: "피해주택 누적 51건 · 최근 보증사고 4건" -->
            <TextView
                android:id="@+id/tvDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="위치를 확인하면 지역 정보가 표시돼요"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ③ 메뉴 버튼 3개 → 각각 다른 화면(Activity)으로 이동 -->
        <Button
            android:id="@+id/btnMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/main_btn_map"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnDiagnosis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/main_btn_diagnosis"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/main_btn_guide"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
