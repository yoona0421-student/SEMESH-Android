<?xml version="1.0" encoding="utf-8"?>
<!-- 가이드 화면: 주제 버튼 3개. 버튼을 누르면 대화상자(AlertDialog)로 내용을 보여준다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".GuideActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="알고 싶은 내용을 눌러 보세요"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnTypes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="전세사기 유형"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="계약 전 4단계 점검"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnSupport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="피해 시 법률·금융 지원"
        android:textSize="18sp" />

    <!-- 남은 공간을 비워서 [뒤로] 버튼을 맨 아래로 밀어냄 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnGuideBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_back" />
</LinearLayout>
